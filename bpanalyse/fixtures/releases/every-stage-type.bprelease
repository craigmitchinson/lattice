  <bpr:object id="280931d8-2b09-3691-2a09-34fe2d0939b7" name="UI Automation Object" bpversion="7.2.1">
    <process id="280931d8-2b09-3691-2a09-34fe2d0939b7" name="UI Automation Object" version="1.0" bpversion="7.2.1" narrative="Exercises every known stage type." type="object">
      <subsheet subsheetid="d02e0a18-d32e-0ed1-d22e-0d3ed52e11f7" type="MainPage" published="False">
        <name>Main Page</name>
      </subsheet>
      <subsheet subsheetid="2d8dd32f-2e8d-d4c2-2f8d-d655288dcb50" type="Normal" published="False">
        <name>Utility Page</name>
      </subsheet>
      <appdef>
        <applicationname>SAP GUI</applicationname>
        <element id="aa766853-ab76-69e6-ac76-6b79ad766d0c" name="Root">
          <type>Application</type>
          <element id="530910b3-5409-1246-5509-13d95609156c" name="Login Button">
            <type>Button</type>
          </element>
          <element id="575e3bf8-5a5e-40b1-595e-3f1e5c5e43d7" name="Username Field">
            <type>Field</type>
          </element>
        </element>
      </appdef>
      <stage stageid="97dee7e1-94de-e328-95de-e4bb9adeec9a" name="Start Stage" type="Start">
        <subsheetid>d02e0a18-d32e-0ed1-d22e-0d3ed52e11f7</subsheetid>
        <display x="75" y="120" w="60" h="30"/>
        <onsuccess>43566f0d-4056-6a54-4156-6be73e56672e</onsuccess>
      </stage>
      <stage stageid="43566f0d-4056-6a54-4156-6be73e56672e" name="Decision Stage" type="Decision">
        <narrative>Branches on the running counter.</narrative>
        <subsheetid>d02e0a18-d32e-0ed1-d22e-0d3ed52e11f7</subsheetid>
        <display x="150" y="120" w="60" h="30"/>
        <onsuccess>044b5f9c-074b-6455-064b-62c2014b5ae3</onsuccess>
        <decision expression="[Counter]&gt;1"/>
        <ontrue>044b5f9c-074b-6455-064b-62c2014b5ae3</ontrue>
        <onfalse>16d99378-19d9-9831-18d9-969e1bd99b57</onfalse>
      </stage>
      <stage stageid="044b5f9c-074b-6455-064b-62c2014b5ae3" name="Calculation Stage" type="Calculation">
        <subsheetid>d02e0a18-d32e-0ed1-d22e-0d3ed52e11f7</subsheetid>
        <display x="225" y="120" w="60" h="30"/>
        <onsuccess>576b8478-5a6b-8931-596b-879e5c6b8c57</onsuccess>
        <calculation expression="[a]+[b]" stage="Result"/>
      </stage>
      <stage stageid="576b8478-5a6b-8931-596b-879e5c6b8c57" name="MultipleCalculation Stage" type="MultipleCalculation">
        <subsheetid>d02e0a18-d32e-0ed1-d22e-0d3ed52e11f7</subsheetid>
        <display x="300" y="120" w="60" h="30"/>
        <onsuccess>9308351c-9608-39d5-9508-384290083063</onsuccess>
        <steps>
          <calculation expression="[a]+[b]" stage="Result"/>
          <calculation expression="[a]-[b]" stage="Diff"/>
        </steps>
      </stage>
      <stage stageid="9308351c-9608-39d5-9508-384290083063" name="ChoiceStart Stage" type="ChoiceStart">
        <subsheetid>d02e0a18-d32e-0ed1-d22e-0d3ed52e11f7</subsheetid>
        <display x="375" y="120" w="60" h="30"/>
        <onsuccess>9a500ced-9750-0834-9850-09c79550050e</onsuccess>
        <choice name="Option A" expression="[x]=1" ontrue="9a500ced-9750-0834-9850-09c79550050e"/>
        <choice name="Option B" expression="[x]=2" ontrue="dc005f23-dd00-60b6-de00-6249df0063dc"/>
      </stage>
      <stage stageid="9a500ced-9750-0834-9850-09c79550050e" name="ChoiceEnd Stage" type="ChoiceEnd">
        <subsheetid>d02e0a18-d32e-0ed1-d22e-0d3ed52e11f7</subsheetid>
        <display x="450" y="120" w="60" h="30"/>
        <onsuccess>dc005f23-dd00-60b6-de00-6249df0063dc</onsuccess>
      </stage>
      <stage stageid="dc005f23-dd00-60b6-de00-6249df0063dc" name="Data Stage" type="Data">
        <narrative>A plain data item.</narrative>
        <subsheetid>d02e0a18-d32e-0ed1-d22e-0d3ed52e11f7</subsheetid>
        <display x="525" y="120" w="60" h="30"/>
        <onsuccess>36931c47-3793-1dda-3893-1f6d31931468</onsuccess>
        <datatype>text</datatype>
        <initialvalue>Hello</initialvalue>
        <exposure>Session</exposure>
        <alwaysinit/>
      </stage>
      <stage stageid="36931c47-3793-1dda-3893-1f6d31931468" name="Collection Stage" type="Collection">
        <subsheetid>d02e0a18-d32e-0ed1-d22e-0d3ed52e11f7</subsheetid>
        <display x="600" y="120" w="60" h="30"/>
        <onsuccess>d8f85b41-d5f8-5688-d6f8-581bdbf85ffa</onsuccess>
        <exposure>None</exposure>
        <collectioninfo>
          <field name="Reference" type="text"/>
          <field name="Amount" type="number"/>
        </collectioninfo>
      </stage>
      <stage stageid="d8f85b41-d5f8-5688-d6f8-581bdbf85ffa" name="Action Stage" type="Action">
        <subsheetid>d02e0a18-d32e-0ed1-d22e-0d3ed52e11f7</subsheetid>
        <display x="675" y="120" w="60" h="30"/>
        <onsuccess>10be4f62-0fbe-4dcf-0ebe-4c3c0dbe4aa9</onsuccess>
        <resource object="Utility Object" action="Do Something"/>
        <inputs>
          <input name="Input1" type="text" expr="&quot;value&quot;"/>
        </inputs>
        <outputs>
          <output name="Output1" type="text" stage="Result"/>
        </outputs>
      </stage>
      <stage stageid="10be4f62-0fbe-4dcf-0ebe-4c3c0dbe4aa9" name="SubSheet Stage" type="SubSheet">
